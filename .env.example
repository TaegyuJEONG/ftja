# Copy to .env (never committed) to judge jobs with your own API key
# instead of your coding agent's tokens. The viewer's Pipeline tab writes
# this file for you.

# "agent" (default: your coding agent's subagents judge) or "api"
FTJA_JUDGE=api

# Your supplier: anthropic, openai, deepseek, gemini, mistral, openrouter,
# or custom (any OpenAI-compatible address, e.g. a local Ollama)
FTJA_PROVIDER=anthropic

# The key for that supplier — only the one you use:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# FTJA_API_KEY=            # for custom
# FTJA_API_BASE=           # for custom, e.g. http://localhost:11434/v1

# Optional: models (each supplier has defaults; openrouter/custom need them)
# FTJA_STAGE1_MODEL=       # also used by the Remote check
# FTJA_REMOTE_MODEL=
# FTJA_STAGE2_MODEL=
