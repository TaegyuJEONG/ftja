# Copy to .env (never committed) to judge jobs with your own model API key
# instead of your coding agent's tokens. The viewer's Pipeline tab can write
# this file for you.

# "agent" (default: your coding agent's subagents judge) or "api"
FTJA_JUDGE=api

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: models per stage (defaults shown)
# FTJA_STAGE1_MODEL=claude-haiku-5-5
# FTJA_REMOTE_MODEL=claude-haiku-5-5
# FTJA_STAGE2_MODEL=claude-sonnet-5-5
