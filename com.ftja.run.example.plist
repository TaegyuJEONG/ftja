<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ftja.run</string>

    <!-- Replace /path/to/FTJA below if this repo ever moves. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>claude</string>
        <string>--print</string>
        <string>/ftja-run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/FTJA</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Not woken from sleep on purpose (SPEC.md: out of scope for M2) —
         if the laptop is asleep at 09:00 the run is just skipped that day. -->
    <key>StandardOutPath</key>
    <string>/path/to/FTJA/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/FTJA/launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
